import express from 'express';
import { createServer } from 'node:http';
import { Server } from 'socket.io';
import { randomInt, randomUUID } from 'node:crypto';
const app=express(), server=createServer(app), io=new Server(server);app.use(express.static('public'));
const rooms=new Map();
const base=["Who's most likely to fuck their ex and call it closure?","Who's most likely to get banned from a bar before midnight?","Who's most likely to send a nude to the wrong group chat?","Who's most likely to hook up with someone purely out of spite?","Who's most likely to wake up in a stranger's house and ask for brunch?","Who's most likely to lie about their body count?","Who's most likely to start a fight at a wedding?","Who's most likely to make out with two people at the same party?","Who's most likely to accidentally expose the group chat?","Who's most likely to get caught stalking an ex's new partner?","Who's most likely to shit-talk someone while accidentally on speakerphone?","Who's most likely to text 'you up?' at 4 a.m.?","Who's most likely to marry rich and divorce richer?","Who's most likely to get kicked out of an Uber?","Who's most likely to flirt their way out of a parking ticket?","Who's most likely to ruin Thanksgiving by revealing a secret?","Who's most likely to end up on a reality dating show?","Who's most likely to go home with the DJ?","Who's most likely to be the reason the friend group needs an NDA?","Who's most likely to get caught hooking up at a house party?"];
function clean(s,max=80){return String(s??'').trim().slice(0,max)}
function roomState(r){return {code:r.code,phase:r.phase,host:r.host,players:[...r.players.values()].map(p=>({id:p.id,name:p.name})),round:r.round,question:r.phase==='voting'?r.questions[r.round]:null,results:r.phase==='results'?results(r):null,total:r.questions.length,voted:r.votes.size}}
function results(r){const counts={};for(const id of r.votes.values())counts[id]=(counts[id]||0)+1;return [...r.players.values()].map(p=>({id:p.id,name:p.name,votes:counts[p.id]||0})).sort((a,b)=>b.votes-a.votes)}
function emit(r){io.to(r.code).emit('state',roomState(r))}
function fail(socket,message){socket.emit('errorMessage',message)}
function getRoom(socket){const r=rooms.get(socket.data.code);if(!r)fail(socket,'Room not found');return r}
function join(socket,r,name,isHost=false){const id=randomUUID();r.players.set(id,{id,name,socketId:socket.id});socket.data={code:r.code,id};socket.join(r.code);if(isHost)r.host=id;socket.emit('identity',{id,code:r.code});emit(r)}
io.on('connection',socket=>{
 socket.on('create',({name,names=[],custom=[]}={})=>{const hostName=clean(name,30);if(!hostName)return fail(socket,'Enter your name');let code;do{code=String(randomInt(100000,1000000))}while(rooms.has(code));const questions=[...base,...custom.map(q=>clean(q,180)).filter(Boolean)].sort(()=>Math.random()-.5);const r={code,host:null,players:new Map(),phase:'lobby',round:0,questions,votes:new Map()};rooms.set(code,r);join(socket,r,hostName,true);for(const n of names.map(n=>clean(n,30)).filter(Boolean)){if(n.toLowerCase()!==hostName.toLowerCase()&&![...r.players.values()].some(p=>p.name.toLowerCase()===n.toLowerCase())){const reservedId=randomUUID();r.players.set(reservedId,{id:reservedId,name:n,socketId:null})}}emit(r)});
 socket.on('join',({code,name}={})=>{const r=rooms.get(clean(code,6)),n=clean(name,30);if(!r)return fail(socket,'Invalid room code');if(r.phase!=='lobby')return fail(socket,'Game already started');if(!n)return fail(socket,'Enter your name');const reserved=[...r.players.entries()].find(([,p])=>p.name.toLowerCase()===n.toLowerCase()&&!p.socketId);if(reserved){const [id,p]=reserved;p.socketId=socket.id;socket.data={code:r.code,id};socket.join(r.code);socket.emit('identity',{id,code:r.code});emit(r)}else if([...r.players.values()].some(p=>p.name.toLowerCase()===n.toLowerCase()))fail(socket,'Name already taken');else join(socket,r,n)});
 socket.on('start',()=>{const r=getRoom(socket);if(!r||r.host!==socket.data.id)return;if(r.players.size<2)return fail(socket,'Add at least two players');r.phase='voting';r.round=0;r.votes.clear();emit(r)});
 socket.on('vote',id=>{const r=getRoom(socket);if(!r||r.phase!=='voting'||!r.players.has(id)||!r.players.has(socket.data.id))return;if(r.votes.has(socket.data.id))return fail(socket,'Already voted');r.votes.set(socket.data.id,id);emit(r)});
 socket.on('reveal',()=>{const r=getRoom(socket);if(!r||r.host!==socket.data.id||r.phase!=='voting')return;r.phase='results';emit(r)});
 socket.on('next',()=>{const r=getRoom(socket);if(!r||r.host!==socket.data.id||r.phase!=='results')return;r.round++;r.votes.clear();r.phase=r.round>=r.questions.length?'done':'voting';emit(r)});
 socket.on('disconnect',()=>{const r=rooms.get(socket.data.code);if(!r)return;const p=r.players.get(socket.data.id);if(p&&p.socketId===socket.id){p.socketId=null;if(r.phase==='lobby'&&socket.data.id!==r.host)r.players.delete(socket.data.id);emit(r)}});
});
server.listen(process.env.PORT||3000,()=>console.log('Hot Mess Express running on port '+(process.env.PORT||3000)));
